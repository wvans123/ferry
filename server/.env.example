# Copy to .env, fill in, then run start.cmd (Windows) or start.sh (Linux). Keep this file on the server only.
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
FERRY_SECRET=change-me
FERRY_TOKEN_WESLEY=change-me
# Leave empty if DEEPSEEK_API_KEY is already set in your Windows environment variables
DEEPSEEK_API_KEY=
# Only if the server needs a proxy to reach the model API:
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
