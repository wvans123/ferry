{
  "name": "ferry-cli",
  "version": "0.14.1",
  "description": "Ferry: a coding agent for restricted networks. The client keeps your files and history; the Ferry server builds the prompt and talks to the model.",
  "type": "module",
  "bin": {
    "ferry": "client/bin/ferry.mjs"
  },
  "files": [
    "client/bin",
    "client/lib",
    "client/ferry.cmd"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@playwright/mcp": "0.0.83",
    "typebox": "1.3.27",
    "undici": "8.10.2"
  },
  "license": "MIT",
  "overrides": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wvans123/ferry.git"
  },
  "scripts": {
    "test": "node --test \"client/test/*.test.mjs\" && python selftest/run.py"
  }
}
